<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MediCatApp.Views.EditProfilePage">

    <ScrollView>
        <VerticalStackLayout
            Spacing="20"
            BackgroundColor="WhiteSmoke">
            <Border 
                Stroke="DarkGrey" 
                BackgroundColor="White">    
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Image Margin="0,5,5,5"
                        Source="medicat_full_logo.png"
                        HeightRequest="60"
                        HorizontalOptions="Center">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateMainCommand}" />
                        </Image.GestureRecognizers>
                    </Image>
                    <Image Margin="0,5,5,5"
                        HeightRequest="50"
                        WidthRequest="50"
                        HorizontalOptions="End">
                        <Image.Source>
                            <UriImageSource Uri="{Binding PhotoUrl}" />
                        </Image.Source>
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateProfileCommand}" />
                        </Image.GestureRecognizers>
                        <Image.Clip>
                            <EllipseGeometry
                                Center="25,25"
                                RadiusX="25"
                                RadiusY="25" />
                        </Image.Clip>
                    </Image>
                </Grid>
            </Border>
            <Image
                HeightRequest="180"
                WidthRequest="180"
                Aspect="AspectFit">
                <Image.Source>
                    <UriImageSource Uri="{Binding Newphotourl}" />
                </Image.Source>
                <Image.Clip>
                    <EllipseGeometry
                        Center="90,90"
                        RadiusX="90"
                        RadiusY="90" />
                </Image.Clip>
            </Image>
            <Grid Margin="50,10,50,-10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label Text="PhotoUrl:"
                    Margin="5,0,0,-5"
                    TextColor="Black"
                    FontSize="14"
                    HorizontalOptions="Start"/>
            </Grid>
            <Border Stroke="DimGrey" Margin="50,0,50,10">
                <Entry ReturnType="Next"
                    Placeholder="{Binding PhotoUrl}"
                    TextColor="Grey"
                    Text="{Binding Newphotourl}"
                    Margin="-5,-5,-5,-5"/>
            </Border>
            <Grid Margin="50,10,50,-10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label Text="Username:"
                    Margin="5,0,0,-5"
                    TextColor="Black"
                    FontSize="14"
                    HorizontalOptions="Start"/>
                <Label Text="{Binding Usernamecheck}"
                    Margin="0,0,0,-5"
                    TextColor="Tomato"
                    FontSize="14"
                    Grid.Column="1"
                    HorizontalOptions="End"/>
            </Grid>
            <Border Stroke="DimGrey" Margin="50,0,50,10">
                <Entry ReturnType="Next"
                    Placeholder="{Binding Username}"
                    MaxLength="32"
                    TextColor="Grey"
                    Text="{Binding Newusername}"
                    Margin="-5,-5,-5,-5"/>
            </Border>
            <Border Stroke="WhiteSmoke" Margin="10,10,5,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="ProfileBtn"
                        Margin="0,5,0,5"
                        Text="Done"
                        BackgroundColor="LightSteelBlue"
                        TextColor="White"
                        FontAttributes="Bold"
                        FontSize="14"
                        FontFamily="Verdana"
                        WidthRequest="120"
                        HorizontalOptions="Center"
                        Command="{Binding UpdateProfileCommand}"/>
                </Grid>
            </Border>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
