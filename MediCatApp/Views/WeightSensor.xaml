<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MediCatApp.Views.WeightSensorPage">

    <ScrollView>
        <VerticalStackLayout
            Spacing="20"
            BackgroundColor="WhiteSmoke">
            <Border 
                Stroke="DarkGrey" 
                BackgroundColor="White">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Image Margin="0,5,5,5"
                        Source="medicat_full_logo.png"
                        HeightRequest="60"
                        HorizontalOptions="Center">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateMainCommand}" />
                        </Image.GestureRecognizers>
                    </Image>
                    <Image Margin="0,5,5,5"
                        HeightRequest="50"
                        WidthRequest="50"
                        HorizontalOptions="End">
                        <Image.Source>
                            <UriImageSource Uri="{Binding PhotoUrl}" />
                        </Image.Source>
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateProfileCommand}" />
                        </Image.GestureRecognizers>
                        <Image.Clip>
                            <EllipseGeometry
                                Center="25,25"
                                RadiusX="25"
                                RadiusY="25" />
                        </Image.Clip>
                    </Image>
                </Grid>
            </Border>
            <!--<Border Stroke="DimGrey" Margin="5,5,5,10">
                <Entry ReturnType="Next"
                    TextColor="Grey"
                    Text="{Binding Webserverdata}"
                    Margin="-5,-5,-5,-5"/>
            </Border>-->
            <Label HorizontalOptions="Center">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="You have " 
                            TextColor="DimGrey"
                            FontSize="20" />
                        <Span Text="{Binding NumOfPills}" 
                            TextColor="DimGrey"
                            FontAttributes="Bold"
                            FontSize="20"/>
                        <Span Text=" pills." 
                            TextColor="DimGrey"
                            FontSize="20" />
                    </FormattedString>
                </Label.FormattedText>
            </Label>
            <Button Margin="0,0,0,100"
                Text="Refresh Pill Count"
                BackgroundColor="LightSteelBlue"
                TextColor="White"
                FontAttributes="Bold"
                FontSize="18"
                FontFamily="Verdana"
                WidthRequest="250"
                HorizontalOptions="Center"
                Command="{Binding RefreshPillCountCommand}"/>
            <Border 
                Stroke="DimGrey" BackgroundColor="Tan">
                <VerticalStackLayout Spacing="5">
                    <Button x:Name="CalibrateBtn"
                        Margin="5,10"
                        Text="{Binding Calibratebuttontext}"
                        BackgroundColor="DimGrey"
                        TextColor="White"
                        FontAttributes="Bold"
                        FontSize="18"
                        FontFamily="Verdana"
                        WidthRequest="250"
                        HorizontalOptions="Center"
                        Command="{Binding CalibrateCommand}"/>
                    <Label Text="{Binding Calibrationmessage}" TextColor="White" FontAttributes="Bold" FontSize="14" HorizontalOptions="Center" Margin="5,10"/>
                </VerticalStackLayout>
            </Border>
            <Label Text="{Binding Errormessage}" TextColor="Tomato" FontSize="14" HorizontalOptions="Center"/>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
