<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MediCatApp.Views.StartPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">
            <Image
                Source="medicat_full_logo.png"
                WidthRequest="280"
                Aspect="AspectFit"
                SemanticProperties.Description="MediCat" />

            <Button x:Name="LoginBtn"
                Text="Login"
                FontFamily="Verdana"
                FontSize="30"
                FontAttributes="Bold"
                TextColor="White"
                BackgroundColor="LightSteelBlue"
                HeightRequest="60"
                WidthRequest="225"
                HorizontalOptions="Center" 
                Clicked="OnLoginClicked" />

            <Label Style="{StaticResource SubHeadline}"
                SemanticProperties.HeadingLevel="Level2">
                <Label.FormattedText>
                    <FormattedString>
                    <Span Text="Don't have an account? " />
                    <Span Text="Sign Up" 
                            TextColor="LightBlue"
                            TextDecorations="Underline">
                    <Span.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSignUpTapped" />
                    </Span.GestureRecognizers>
                    </Span>
                    <Span Text=" here" />
                    </FormattedString>
                </Label.FormattedText>
            </Label>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
