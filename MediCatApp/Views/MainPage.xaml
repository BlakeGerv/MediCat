<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MediCatApp.Views.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Spacing="20"
            BackgroundColor="WhiteSmoke">
            <Border 
                Stroke="DarkGrey" 
                BackgroundColor="White">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Image Margin="0,5,5,5"
                        Source="medicat_full_logo.png"
                        HeightRequest="60"
                        HorizontalOptions="Center"/>
                    <Image Margin="0,5,5,5"
                        HeightRequest="50"
                        WidthRequest="50"
                        HorizontalOptions="End">
                        <Image.Source>
                            <UriImageSource Uri="{Binding PhotoUrl}" />
                        </Image.Source>
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateProfileCommand}" />
                        </Image.GestureRecognizers>
                        <Image.Clip>
                            <EllipseGeometry
                                Center="25,25"
                                RadiusX="25"
                                RadiusY="25" />
                        </Image.Clip>
                    </Image>
                </Grid>
            </Border>
            <Label
                Text="Main Page"
                TextColor="Black"
                Style="{StaticResource Headline}"
                SemanticProperties.HeadingLevel="Level1" />
            <Button
                Text="Cat Robot"
                BackgroundColor="LightSteelBlue"
                TextColor="White"
                FontAttributes="Bold"
                FontSize="24"
                FontFamily="Verdana"
                HeightRequest="50"
                WidthRequest="250"
                HorizontalOptions="Center"
                Command="{Binding NavigateCatRobotCommand}"/>
            <Button
                Text="Weight Sensor"
                BackgroundColor="LightSteelBlue"
                TextColor="White"
                FontAttributes="Bold"
                FontSize="24"
                FontFamily="Verdana"
                HeightRequest="50"
                WidthRequest="250"
                HorizontalOptions="Center"
                Command="{Binding NavigateWeightSensorCommand}"/>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
