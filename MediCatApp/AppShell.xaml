<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MediCatApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MediCatApp.Views"
    Shell.FlyoutBehavior="Disabled"
    Title="MediCatApp">

    <ShellContent
        ContentTemplate="{DataTemplate local:StartPage}"
        Route="StartPage"/>
    <ShellContent
        ContentTemplate="{DataTemplate local:SignUpPage}"
        Route="SignUp"/>
    <ShellContent
        ContentTemplate="{DataTemplate local:LoginPage}"
        Route="Login"/>
    <ShellContent
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="Main"/>
    <ShellContent
        ContentTemplate="{DataTemplate local:ProfilePage}"
        Route="Profile"/>
    <ShellContent
        ContentTemplate="{DataTemplate local:EditProfilePage}"
        Route="EditProfile"/>
    <ShellContent
        ContentTemplate="{DataTemplate local:CatRobotPage}"
        Route="CatRobot"/>
    <ShellContent
        ContentTemplate="{DataTemplate local:WeightSensorPage}"
        Route="WeightSensor"/>

</Shell>
